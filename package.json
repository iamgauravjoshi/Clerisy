{
  "name": "clerisy",
  "version": "1.0.0",
  "description": "AI project meeting intelligence: what changed in the project because of this meeting?",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome ci .",
    "icons": "node scripts/build-icons.mjs",
    "site": "node scripts/serve-site.mjs"
  },
  "author": "Clerisy",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.74",
    "@ai-sdk/google": "^4.0.90",
    "@ai-sdk/openai": "^4.0.86",
    "@ai-sdk/openai-compatible": "^3.0.65",
    "ai": "^7.0.130",
    "electron-updater": "^6.8.9",
    "sherpa-onnx-node": "1.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.6.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "productName": "Clerisy",
  "build": {
    "appId": "com.meetingbuddy.app",
    "productName": "Clerisy",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-win-x64/**"
    ],
    "extraResources": [
      {
        "from": "resources/icons",
        "to": "icons"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "iamgauravjoshi",
      "repo": "Clerisy",
      "releaseType": "draft"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clerisy",
      "deleteAppDataOnUninstall": false
    }
  },
  "overrides": {
    "global-agent": "^4.1.3"
  }
}
