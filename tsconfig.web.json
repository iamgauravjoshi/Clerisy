{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@resources/*": ["./resources/*"]
    },
    "types": ["node"]
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "src/preload/index.d.ts", "src/main/env.d.ts"]
}
