{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Biome lints and formats without loading TypeScript, which matters here: TypeScript 7 is the native port and
  // has no JS API for typescript-eslint to use.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!out", "!release", "!.agents", "!skills-lock.json", "!package-lock.json"]
  },
  // import sorting is off to keep diffs about behaviour
  "assist": { "enabled": false },
  // matches the existing style: 2 spaces, single quotes, no semicolons, no trailing commas
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "none",
      "arrowParentheses": "always"
    }
  },
  // Tailwind v4 directives (@theme, @utility, @apply) are CSS syntax Biome only parses when told to
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        // there are no <form> elements, so a button can't accidentally submit one
        "useButtonType": "off",
        // dialogs move focus to their first field when they open, as dialogs should
        "noAutofocus": "off"
      },
      // `!` is used deliberately where strict TypeScript can't see an invariant
      "style": { "noNonNullAssertion": "off" },
      // one Tailwind class order everywhere keeps class lists scannable and diffs small (DESIGN.md §5.1)
      "nursery": { "useSortedClasses": { "level": "error", "fix": "safe", "options": { "functions": ["cn", "cva"] } } }
    }
  },
  "overrides": [
    {
      // primitives know nothing about the app: no api, no domain types, no features (DESIGN.md §5)
      "includes": ["src/renderer/src/components/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/api", "@shared/**", "**/features/**", "**/pages/**", "../domain/**", "../layout/**"],
                    "message": "components/ui is generic: it may use lib/ and other primitives only. Domain wrappers belong in components/domain."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // domain wrappers and layout render what they're given; data comes from features and pages
      "includes": ["src/renderer/src/components/domain/**", "src/renderer/src/components/layout/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/api", "**/features/**", "**/pages/**"],
                    "message": "components/domain and components/layout don't load data or use features; pass what they need as props."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // a feature never reaches into a page or another feature's internals; share through components/ or lib/
      "includes": ["src/renderer/src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/pages/**", "../*/**", "!../../**"],
                    "message": "Features don't import pages or other features. Move what both need into components/domain or lib/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // helpers and hooks sit below the UI
      "includes": ["src/renderer/src/lib/**", "src/renderer/src/hooks/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/components/**", "**/features/**", "**/pages/**"],
                    "message": "lib/ and hooks/ must not depend on components, features or pages."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // test doubles are loosely typed on purpose
      "includes": ["test/**"],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
    },
    {
      // the renderer runs sandboxed without Node.js (see sandbox: true in src/main/index.ts)
      "includes": ["src/renderer/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Buffer": "The renderer is sandboxed and has no Node.js; use Uint8Array.",
                  "process": "The renderer is sandboxed and has no Node.js.",
                  "require": "The renderer is sandboxed and has no Node.js; use import.",
                  "__dirname": "The renderer is sandboxed and has no Node.js.",
                  "global": "The renderer is sandboxed; use window or globalThis."
                }
              }
            }
          }
        }
      }
    }
  ]
}
